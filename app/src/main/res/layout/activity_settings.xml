<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/settings"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- ===== 外观 ===== -->
            <TextView
                style="@style/Widget.HtmlNotes.Settings.SectionTitle"
                android:layout_marginTop="12dp"
                android:text="@string/settings_appearance" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HtmlNotes.Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 主题 -->
                    <LinearLayout
                        android:id="@+id/rowTheme"
                        style="@style/Widget.HtmlNotes.Settings.Row">

                        <ImageView
                            style="@style/Widget.HtmlNotes.Settings.Icon"
                            android:src="@drawable/ic_theme" />

                        <TextView
                            style="@style/Widget.HtmlNotes.Settings.Title"
                            android:text="@string/settings_theme" />

                        <TextView
                            android:id="@+id/themeValue"
                            style="@style/Widget.HtmlNotes.Settings.Value" />
                    </LinearLayout>

                    <View style="@style/Widget.HtmlNotes.Settings.Divider" />

                    <!-- 主题色 -->
                    <LinearLayout
                        android:id="@+id/rowThemeColor"
                        style="@style/Widget.HtmlNotes.Settings.Row">

                        <ImageView
                            style="@style/Widget.HtmlNotes.Settings.Icon"
                            android:src="@drawable/ic_palette" />

                        <TextView
                            style="@style/Widget.HtmlNotes.Settings.Title"
                            android:text="@string/settings_theme_color" />

                        <View
                            android:id="@+id/themeColorDot"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_dot"
                            android:backgroundTint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/themeColorValue"
                            style="@style/Widget.HtmlNotes.Settings.Value" />
                    </LinearLayout>

                    <View style="@style/Widget.HtmlNotes.Settings.Divider" />

                    <!-- 默认视图 -->
                    <LinearLayout
                        android:id="@+id/rowDefaultView"
                        style="@style/Widget.HtmlNotes.Settings.Row">

                        <ImageView
                            style="@style/Widget.HtmlNotes.Settings.Icon"
                            android:src="@drawable/ic_grid" />

                        <TextView
                            style="@style/Widget.HtmlNotes.Settings.Title"
                            android:text="@string/settings_default_view" />

                        <TextView
                            android:id="@+id/viewValue"
                            style="@style/Widget.HtmlNotes.Settings.Value" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 数据 ===== -->
            <TextView
                style="@style/Widget.HtmlNotes.Settings.SectionTitle"
                android:layout_marginTop="20dp"
                android:text="@string/settings_data" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HtmlNotes.Settings.Card">

                <LinearLayout
                    android:id="@+id/rowClear"
                    style="@style/Widget.HtmlNotes.Settings.Row">

                    <ImageView
                        style="@style/Widget.HtmlNotes.Settings.Icon"
                        android:src="@drawable/ic_delete"
                        app:tint="?attr/colorError" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_clear"
                            android:textColor="?attr/colorError"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_clear_summary"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 关于 ===== -->
            <TextView
                style="@style/Widget.HtmlNotes.Settings.SectionTitle"
                android:layout_marginTop="20dp"
                android:text="@string/settings_about" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HtmlNotes.Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 作者 -->
                    <LinearLayout style="@style/Widget.HtmlNotes.Settings.RowBase">

                        <ImageView
                            style="@style/Widget.HtmlNotes.Settings.Icon"
                            android:src="@drawable/ic_person" />

                        <TextView
                            style="@style/Widget.HtmlNotes.Settings.Title"
                            android:text="@string/settings_author" />

                        <TextView
                            style="@style/Widget.HtmlNotes.Settings.Value"
                            android:text="@string/author_name" />
                    </LinearLayout>

                    <View style="@style/Widget.HtmlNotes.Settings.Divider" />

                    <!-- 邮箱（点击发邮件） -->
                    <LinearLayout
                        android:id="@+id/rowEmail"
                        style="@style/Widget.HtmlNotes.Settings.Row">

                        <ImageView
                            style="@style/Widget.HtmlNotes.Settings.Icon"
                            android:src="@drawable/ic_email" />

                        <TextView
                            style="@style/Widget.HtmlNotes.Settings.Title"
                            android:text="@string/settings_email" />

                        <TextView
                            style="@style/Widget.HtmlNotes.Settings.Value"
                            android:text="@string/author_email" />
                    </LinearLayout>

                    <View style="@style/Widget.HtmlNotes.Settings.Divider" />

                    <!-- GitHub（点击打开主页） -->
                    <LinearLayout
                        android:id="@+id/rowGithub"
                        style="@style/Widget.HtmlNotes.Settings.Row">

                        <ImageView
                            style="@style/Widget.HtmlNotes.Settings.Icon"
                            android:src="@drawable/ic_link" />

                        <TextView
                            style="@style/Widget.HtmlNotes.Settings.Title"
                            android:text="@string/settings_github" />

                        <TextView
                            style="@style/Widget.HtmlNotes.Settings.Value"
                            android:text="@string/author_github" />
                    </LinearLayout>

                    <View style="@style/Widget.HtmlNotes.Settings.Divider" />

                    <!-- 版本 -->
                    <LinearLayout style="@style/Widget.HtmlNotes.Settings.RowBase">

                        <ImageView
                            style="@style/Widget.HtmlNotes.Settings.Icon"
                            android:src="@drawable/ic_info" />

                        <TextView
                            style="@style/Widget.HtmlNotes.Settings.Title"
                            android:text="@string/settings_version" />

                        <TextView
                            android:id="@+id/versionValue"
                            style="@style/Widget.HtmlNotes.Settings.Value" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
