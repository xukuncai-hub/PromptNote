<?xml version="1.0" encoding="utf-8"?>
<!--
  tools:ignore="HardcodedText" —— 工具栏上的 B / I / U / S / Aa / A 是字形标签而非文案，
  各语言下都保持不变、也无需翻译，做成字符串资源只会增加维护负担。

  tools:ignore="TooManyViews" —— 视图数偏多来自工具栏的三个面板，其中大部分常态是 GONE、
  不参与测量与绘制。拆成 include / ViewStub 会让首次展开多一次 inflate，反而更慢。

  HorizontalScrollView 上的 tools:ignore="ScrollViewSize" —— 这些滚动容器有意使用
  fillViewport + 子视图 match_parent + gravity="center"：内容放得下时居中，放不下时才滚动，
  小屏不会再被裁掉。lint 的该规则不适用于这种用法。

  工具按钮的公共属性（尺寸/背景/前景/配色）统一收进 values/styles.xml 的
  Widget.HtmlNotes.Tool.* 样式，这里只保留 id、文案与个别差异项。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="HardcodedText,TooManyViews">

    <!-- ============ 1. 顶部导航栏 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.HtmlNotes.TopIconButton"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/btnUndo"
            style="@style/Widget.HtmlNotes.TopIconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:contentDescription="@string/rich_undo"
            android:src="@drawable/ic_undo" />

        <ImageButton
            android:id="@+id/btnRedo"
            style="@style/Widget.HtmlNotes.TopIconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:contentDescription="@string/rich_redo"
            android:src="@drawable/ic_redo" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 预览：HTML 便签的核心操作，从「更多」菜单提到顶栏（仅 HTML 便签可见） -->
        <ImageButton
            android:id="@+id/btnPreview"
            style="@style/Widget.HtmlNotes.TopIconButton"
            android:contentDescription="@string/btn_preview"
            android:src="@drawable/ic_preview"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnMore"
            style="@style/Widget.HtmlNotes.TopIconButton"
            android:contentDescription="@string/more_menu"
            android:src="@drawable/ic_more" />

        <TextView
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_done_btn"
            android:contentDescription="@string/done"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/done"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 顶栏细分隔线，与正文区做视觉分层 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- ============ 2. 笔记元数据栏（时间 · 字数 + 保存状态） ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/metaTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/saveState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.0"
            android:background="@drawable/bg_save_status"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/status_saved"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ============ 3. 正文编辑区：标题 ============ -->
    <!-- 光标统一黄色细竖线；背景 @null 去掉系统默认下划线；textMultiLine 支持多行标题；
         左侧对齐统一用 20dp（与正文一致），不依赖系统 padding 制造光标偏移 -->
    <EditText
        android:id="@+id/edTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:hint="@string/hint_title"
        android:inputType="textMultiLine|textCapSentences"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        android:textCursorDrawable="@drawable/text_cursor"
        android:fontFamily="serif"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- ============ 4. 正文编辑区 + 底部工具栏（纵向布局：正文在上、工具栏在下，工具栏不覆盖正文） ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 正文：文字便签（富文本所见即所得）。子类用于在浮条接管时挡掉系统选择菜单 -->
        <com.htmlnotes.app.SelectableWebView
            android:id="@+id/richWeb"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone" />

        <!-- 正文：HTML 便签（代码编辑，带行号）；工具栏在下方布局流中，正文不会被覆盖 -->
        <com.htmlnotes.app.CodeEditText
            android:id="@+id/edContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@null"
            android:fadeScrollbars="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="top|start"
            android:hint="@string/hint_code"
            android:imeOptions="actionNone"
            android:inputType="textMultiLine|textNoSuggestions"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:scrollbars="vertical"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textCursorDrawable="@drawable/text_cursor"
            android:textSize="16sp"
            android:typeface="monospace"
            android:visibility="gone" />

        <!-- ════════ 文字模式：ColorOS 16 官方风格两级悬浮操作岛 ════════ -->
        <LinearLayout
            android:id="@+id/toolbarText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_toolbar_dock"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp">

            <!-- 1. ColorOS 文本排版副面板 (点击 Aa 展开/收起) -->
            <LinearLayout
                android:id="@+id/panelTextBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- 1.1 ColorOS 经典分段选择器 [ 正文 | 大标题 | 中标题 | 小标题 ] -->
                <LinearLayout
                    android:id="@+id/layoutSegment"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_coloros_segment_container"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/segBody"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_coloros_segment_item"
                        android:gravity="center"
                        android:text="@string/seg_body"
                        android:textColor="@color/color_segment_text"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/segTitle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_coloros_segment_item"
                        android:gravity="center"
                        android:text="@string/rich_h1"
                        android:textColor="@color/color_segment_text"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/segSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_coloros_segment_item"
                        android:gravity="center"
                        android:text="@string/rich_h2"
                        android:textColor="@color/color_segment_text"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/segHeading"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_coloros_segment_item"
                        android:gravity="center"
                        android:text="@string/rich_h3"
                        android:textColor="@color/color_segment_text"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 1.2 行内格式与排版快捷横滑条 -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:id="@+id/btnTB"
                            style="@style/Widget.HtmlNotes.Tool.Square"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:contentDescription="@string/rich_bold"
                            android:text="B"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnTI"
                            style="@style/Widget.HtmlNotes.Tool.Square"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:contentDescription="@string/rich_italic"
                            android:text="I"
                            android:textSize="16sp"
                            android:textStyle="italic" />

                        <TextView
                            android:id="@+id/btnTU"
                            style="@style/Widget.HtmlNotes.Tool.Square"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:contentDescription="@string/rich_underline"
                            android:text="U"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnTS"
                            style="@style/Widget.HtmlNotes.Tool.Square"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:contentDescription="@string/style_strike"
                            android:text="S"
                            android:textSize="16sp" />

                        <View
                            android:layout_width="0.6dp"
                            android:layout_height="18dp"
                            android:layout_marginHorizontal="6dp"
                            android:background="?attr/colorOutlineVariant" />

                        <ImageButton
                            android:id="@+id/btnAlignL"
                            style="@style/Widget.HtmlNotes.Tool.Icon36"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:contentDescription="@string/rich_align_left"
                            android:src="@drawable/ic_align_left" />

                        <ImageButton
                            android:id="@+id/btnAlignC"
                            style="@style/Widget.HtmlNotes.Tool.Icon36"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:contentDescription="@string/rich_align_center"
                            android:src="@drawable/ic_align_center" />

                        <ImageButton
                            android:id="@+id/btnAlignR"
                            style="@style/Widget.HtmlNotes.Tool.Icon36"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:contentDescription="@string/rich_align_right"
                            android:src="@drawable/ic_align_right" />

                        <View
                            android:layout_width="0.6dp"
                            android:layout_height="18dp"
                            android:layout_marginHorizontal="6dp"
                            android:background="?attr/colorOutlineVariant" />

                        <ImageButton
                            android:id="@+id/btnOutdent"
                            style="@style/Widget.HtmlNotes.Tool.Icon36"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:contentDescription="@string/para_outdent"
                            android:src="@drawable/ic_outdent" />

                        <ImageButton
                            android:id="@+id/btnIndent"
                            style="@style/Widget.HtmlNotes.Tool.Icon36"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:contentDescription="@string/para_indent"
                            android:src="@drawable/ic_indent" />

                        <ImageButton
                            android:id="@+id/btnQuote"
                            style="@style/Widget.HtmlNotes.Tool.Icon36"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:contentDescription="@string/para_quote"
                            android:src="@drawable/ic_quote" />

                        <ImageButton
                            android:id="@+id/btnHr"
                            style="@style/Widget.HtmlNotes.Tool.Icon36"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:contentDescription="@string/insert_hr"
                            android:src="@drawable/ic_hr" />

                        <TextView
                            android:id="@+id/btnColor"
                            style="@style/Widget.HtmlNotes.Tool.Chip"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_a_color"
                            android:contentDescription="@string/rich_color"
                            android:text="A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnHl"
                            style="@style/Widget.HtmlNotes.Tool.Chip"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_tool_hl"
                            android:contentDescription="@string/style_highlight"
                            android:text="A"
                            android:textColor="@color/hl_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnSize"
                            style="@style/Widget.HtmlNotes.Tool.Chip"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/font_size"
                            android:text="字号"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnFont"
                            style="@style/Widget.HtmlNotes.Tool.Chip"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/font_system"
                            android:text="字体"
                            android:textSize="12sp" />

                        <ImageButton
                            android:id="@+id/btnLink"
                            style="@style/Widget.HtmlNotes.Tool.Icon36"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/insert_link"
                            android:src="@drawable/ic_link" />

                        <ImageButton
                            android:id="@+id/btnCode"
                            style="@style/Widget.HtmlNotes.Tool.Icon36"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/para_code"
                            android:src="@drawable/ic_code" />

                        <ImageButton
                            android:id="@+id/btnOl"
                            style="@style/Widget.HtmlNotes.Tool.Icon36"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/rich_ol"
                            android:src="@drawable/ic_list_ol" />

                        <ImageButton
                            android:id="@+id/btnClear"
                            style="@style/Widget.HtmlNotes.Tool.Icon36"
                            android:background="@drawable/bg_coloros_tool_button"
                            android:contentDescription="@string/rich_clear"
                            android:src="@drawable/ic_close" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- 分割线 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.6dp"
                    android:layout_marginTop="4dp"
                    android:background="?attr/colorOutlineVariant" />
            </LinearLayout>

            <!-- 2. ColorOS 经典常驻主工具栏 (5大核心操作等距排布) -->
            <LinearLayout
                android:id="@+id/barMainTools"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 2.1 Aa 格式面板展开/收起切换开关 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/btnToggleAa"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_coloros_tool_button"
                        android:contentDescription="排版与样式"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_coloros_richtext"
                        app:tint="@color/tool_btn_tint" />
                </FrameLayout>

                <!-- 2.2 待办任务清单 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/btnTodo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_coloros_tool_button"
                        android:contentDescription="@string/todo_menu"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_coloros_todo"
                        app:tint="@color/tool_btn_tint" />
                </FrameLayout>

                <!-- 2.3 插入图片 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/btnImage"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_coloros_tool_button"
                        android:contentDescription="@string/insert_image"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_coloros_image"
                        app:tint="@color/tool_btn_tint" />
                </FrameLayout>

                <!-- 2.4 调色板 / 荧光高亮笔 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/btnPalette"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_coloros_tool_button"
                        android:contentDescription="色彩与高亮"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_coloros_palette"
                        app:tint="@color/tool_btn_tint" />
                </FrameLayout>

                <!-- 2.5 列表 (无序/有序) -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/btnUl"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_coloros_tool_button"
                        android:contentDescription="@string/rich_ul"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_coloros_list"
                        app:tint="@color/tool_btn_tint" />
                </FrameLayout>

                <!-- 2.6 更多操作抽屉 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/btnMoreTools"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_coloros_tool_button"
                        android:contentDescription="@string/more_menu"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_more"
                        app:tint="@color/tool_btn_tint" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ════════ 代码模式：单层平铺代码工具栏 ════════ -->
        <LinearLayout
            android:id="@+id/toolbarCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_toolbar_dock"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <ImageButton
                        android:id="@+id/btnCIndent"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/code_indent"
                        android:src="@drawable/ic_indent" />

                    <ImageButton
                        android:id="@+id/btnCOutdent"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/code_outdent"
                        android:src="@drawable/ic_outdent" />

                    <ImageButton
                        android:id="@+id/btnFormatCode"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/format_code"
                        android:src="@drawable/ic_format" />

                    <ImageButton
                        android:id="@+id/btnClearCode"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/clear_code"
                        android:src="@drawable/ic_delete" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="?attr/colorOutlineVariant" />

                    <TextView
                        android:id="@+id/btnSnLink"
                        style="@style/Widget.HtmlNotes.Tool.Chip.Wide"
                        android:layout_marginEnd="4dp"
                        android:text="@string/insert_link" />

                    <TextView
                        android:id="@+id/btnSnImage"
                        style="@style/Widget.HtmlNotes.Tool.Chip.Wide"
                        android:layout_marginEnd="4dp"
                        android:text="@string/insert_image" />

                    <TextView
                        android:id="@+id/btnSnUl"
                        style="@style/Widget.HtmlNotes.Tool.Chip.Wide"
                        android:layout_marginEnd="4dp"
                        android:text="@string/rich_ul" />

                    <TextView
                        android:id="@+id/btnSnHr"
                        style="@style/Widget.HtmlNotes.Tool.Chip.Wide"
                        android:layout_marginEnd="4dp"
                        android:text="@string/insert_hr" />

                    <TextView
                        android:id="@+id/btnSnTodo"
                        style="@style/Widget.HtmlNotes.Tool.Chip.Wide"
                        android:layout_marginEnd="4dp"
