<?xml version="1.0" encoding="utf-8"?>
<!--
  tools:ignore="HardcodedText" —— 工具栏上的 B / I / U / S / Aa / A 是字形标签而非文案，
  各语言下都保持不变、也无需翻译，做成字符串资源只会增加维护负担。

  tools:ignore="TooManyViews" —— 视图数偏多来自工具栏的三个面板，其中大部分常态是 GONE、
  不参与测量与绘制。拆成 include / ViewStub 会让首次展开多一次 inflate，反而更慢。

  HorizontalScrollView 上的 tools:ignore="ScrollViewSize" —— 这些滚动容器有意使用
  fillViewport + 子视图 match_parent + gravity="center"：内容放得下时居中，放不下时才滚动，
  小屏不会再被裁掉。lint 的该规则不适用于这种用法。

  工具按钮的公共属性（尺寸/背景/前景/配色）统一收进 values/styles.xml 的
  Widget.HtmlNotes.Tool.* 样式，这里只保留 id、文案与个别差异项。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="HardcodedText,TooManyViews">

    <!-- ============ 1. 顶部导航栏 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.HtmlNotes.TopIconButton"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/btnUndo"
            style="@style/Widget.HtmlNotes.TopIconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:contentDescription="@string/rich_undo"
            android:src="@drawable/ic_undo" />

        <ImageButton
            android:id="@+id/btnRedo"
            style="@style/Widget.HtmlNotes.TopIconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:contentDescription="@string/rich_redo"
            android:src="@drawable/ic_redo" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 预览：HTML 便签的核心操作，从「更多」菜单提到顶栏（仅 HTML 便签可见） -->
        <ImageButton
            android:id="@+id/btnPreview"
            style="@style/Widget.HtmlNotes.TopIconButton"
            android:contentDescription="@string/btn_preview"
            android:src="@drawable/ic_preview"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnMore"
            style="@style/Widget.HtmlNotes.TopIconButton"
            android:contentDescription="@string/more_menu"
            android:src="@drawable/ic_more" />

        <TextView
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_done_btn"
            android:contentDescription="@string/done"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/done"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 顶栏细分隔线，与正文区做视觉分层 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- ============ 2. 笔记元数据栏（时间 · 字数 + 保存状态） ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/metaTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/saveState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.0"
            android:background="@drawable/bg_save_status"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/status_saved"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ============ 3. 正文编辑区：标题 ============ -->
    <!-- 光标统一黄色细竖线；背景 @null 去掉系统默认下划线；textMultiLine 支持多行标题；
         左侧对齐统一用 20dp（与正文一致），不依赖系统 padding 制造光标偏移 -->
    <EditText
        android:id="@+id/edTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:hint="@string/hint_title"
        android:inputType="textMultiLine|textCapSentences"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        android:textCursorDrawable="@drawable/text_cursor"
        android:fontFamily="serif"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- ============ 4. 正文编辑区 + 底部工具栏（纵向布局：正文在上、工具栏在下，工具栏不覆盖正文） ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 正文：文字便签（富文本所见即所得）。子类用于在浮条接管时挡掉系统选择菜单 -->
        <com.htmlnotes.app.SelectableWebView
            android:id="@+id/richWeb"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- 正文：HTML 便签（代码编辑，带行号）；工具栏在下方布局流中，正文不会被覆盖 -->
        <com.htmlnotes.app.CodeEditText
            android:id="@+id/edContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@null"
            android:fadeScrollbars="false"
            android:gravity="top|start"
            android:hint="@string/hint_code"
            android:imeOptions="actionNone"
            android:inputType="textMultiLine|textNoSuggestions"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:scrollbars="vertical"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textCursorDrawable="@drawable/text_cursor"
            android:textSize="16sp"
            android:typeface="monospace"
            android:visibility="gone" />

        <!-- ════════ 文字模式：单层平铺横向格式栏（微信/Apple Notes 风格，直观高效零多余点击） ════════ -->
        <LinearLayout
            android:id="@+id/toolbarText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_toolbar_dock"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <!-- 1. 基础字符格式 B / I / U / S -->
                    <TextView
                        android:id="@+id/btnTB"
                        style="@style/Widget.HtmlNotes.Tool.Square"
                        android:contentDescription="@string/rich_bold"
                        android:text="B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnTI"
                        style="@style/Widget.HtmlNotes.Tool.Square"
                        android:contentDescription="@string/rich_italic"
                        android:text="I"
                        android:textSize="16sp"
                        android:textStyle="italic" />

                    <TextView
                        android:id="@+id/btnTU"
                        style="@style/Widget.HtmlNotes.Tool.Square"
                        android:contentDescription="@string/rich_underline"
                        android:text="U"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnTS"
                        style="@style/Widget.HtmlNotes.Tool.Square"
                        android:contentDescription="@string/style_strike"
                        android:text="S"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- 2. 标题层级 H1 / H2 / H3 / 正文 -->
                    <TextView
                        android:id="@+id/segTitle"
                        style="@style/Widget.HtmlNotes.Tool.Chip"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/rich_h1"
                        android:text="H1"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/segSubtitle"
                        style="@style/Widget.HtmlNotes.Tool.Chip"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/rich_h2"
                        android:text="H2"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/segHeading"
                        style="@style/Widget.HtmlNotes.Tool.Chip"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/rich_h3"
                        android:text="H3"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/segBody"
                        style="@style/Widget.HtmlNotes.Tool.Chip"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/seg_body"
                        android:text="正文"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- 3. 列表与清单 待办 / 无序列表 / 有序列表 / 引用 -->
                    <ImageButton
                        android:id="@+id/btnTodo"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/todo_menu"
                        android:src="@drawable/ic_checklist" />

                    <ImageButton
                        android:id="@+id/btnUl"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/rich_ul"
                        android:src="@drawable/ic_list_ul" />

                    <ImageButton
                        android:id="@+id/btnOl"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/rich_ol"
                        android:src="@drawable/ic_list_ol" />

                    <ImageButton
                        android:id="@+id/btnQuote"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/para_quote"
                        android:src="@drawable/ic_quote" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- 4. 对齐方式 左 / 中 / 右 -->
                    <ImageButton
                        android:id="@+id/btnAlignL"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/rich_align_left"
                        android:src="@drawable/ic_align_left" />

                    <ImageButton
                        android:id="@+id/btnAlignC"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/rich_align_center"
                        android:src="@drawable/ic_align_center" />

                    <ImageButton
                        android:id="@+id/btnAlignR"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/rich_align_right"
                        android:src="@drawable/ic_align_right" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- 5. 颜色 / 高亮 / 字号 / 字体 -->
                    <TextView
                        android:id="@+id/btnColor"
                        style="@style/Widget.HtmlNotes.Tool.Chip"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_a_color"
                        android:contentDescription="@string/rich_color"
                        android:text="A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnHl"
                        style="@style/Widget.HtmlNotes.Tool.Chip"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_tool_hl"
                        android:contentDescription="@string/style_highlight"
                        android:text="A"
                        android:textColor="@color/hl_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnSize"
                        style="@style/Widget.HtmlNotes.Tool.Chip"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/font_size"
                        android:text="字号"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnFont"
                        style="@style/Widget.HtmlNotes.Tool.Chip"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/font_system"
                        android:text="字体"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- 6. 高级插入与格式 (链接 / 图片 / 代码 / 缩进 / 清除) -->
                    <ImageButton
                        android:id="@+id/btnLink"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/insert_link"
                        android:src="@drawable/ic_link" />

                    <ImageButton
                        android:id="@+id/btnImage"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/insert_image"
                        android:src="@drawable/ic_image" />

                    <ImageButton
                        android:id="@+id/btnCode"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/para_code"
                        android:src="@drawable/ic_code" />

                    <ImageButton
                        android:id="@+id/btnHr"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/insert_hr"
                        android:src="@drawable/ic_hr" />

                    <ImageButton
                        android:id="@+id/btnOutdent"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/para_outdent"
                        android:src="@drawable/ic_outdent" />

                    <ImageButton
                        android:id="@+id/btnIndent"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/para_indent"
                        android:src="@drawable/ic_indent" />

                    <ImageButton
                        android:id="@+id/btnClear"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:contentDescription="@string/rich_clear"
                        android:src="@drawable/ic_close" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ════════ 代码模式：单层平铺代码工具栏 ════════ -->
        <LinearLayout
            android:id="@+id/toolbarCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_toolbar_dock"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <ImageButton
                        android:id="@+id/btnCIndent"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/code_indent"
                        android:src="@drawable/ic_indent" />

                    <ImageButton
                        android:id="@+id/btnCOutdent"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/code_outdent"
                        android:src="@drawable/ic_outdent" />

                    <ImageButton
                        android:id="@+id/btnFormatCode"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/format_code"
                        android:src="@drawable/ic_format" />

                    <ImageButton
                        android:id="@+id/btnClearCode"
                        style="@style/Widget.HtmlNotes.Tool.Icon36"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/clear_code"
                        android:src="@drawable/ic_delete" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="?attr/colorOutlineVariant" />

                    <TextView
                        android:id="@+id/btnSnLink"
                        style="@style/Widget.HtmlNotes.Tool.Chip.Wide"
                        android:layout_marginEnd="4dp"
                        android:text="@string/insert_link" />

                    <TextView
                        android:id="@+id/btnSnImage"
                        style="@style/Widget.HtmlNotes.Tool.Chip.Wide"
                        android:layout_marginEnd="4dp"
                        android:text="@string/insert_image" />

                    <TextView
                        android:id="@+id/btnSnUl"
                        style="@style/Widget.HtmlNotes.Tool.Chip.Wide"
                        android:layout_marginEnd="4dp"
                        android:text="@string/rich_ul" />

                    <TextView
                        android:id="@+id/btnSnHr"
                        style="@style/Widget.HtmlNotes.Tool.Chip.Wide"
                        android:layout_marginEnd="4dp"
                        android:text="@string/insert_hr" />

                    <TextView
                        android:id="@+id/btnSnTodo"
                        style="@style/Widget.HtmlNotes.Tool.Chip.Wide"
                        android:layout_marginEnd="4dp"
                        android:text="@string/todo_menu" />

                    <TextView
                        android:id="@+id/btnSnCheck"
                        style="@style/Widget.HtmlNotes.Tool.Chip.Wide"
                        android:layout_marginEnd="4dp"
                        android:text="@string/check_list" />

                    <TextView
                        android:id="@+id/btnCopyAll"
                        style="@style/Widget.HtmlNotes.Tool.Chip.Wide"
                        android:text="@string/copy_all_code" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
