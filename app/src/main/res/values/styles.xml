<?xml version="1.0" encoding="utf-8"?>
<!--
  布局公共样式：编辑器工具栏按钮、设置页行、"更多"弹层行的重复属性收敛于此。
  布局文件只保留 id、文案与个别差异项（尺寸覆盖、配色覆盖等）。
-->
<resources>

    <!-- 分组锚点：点号命名会派生隐式父样式，必须先定义空锚点 -->
    <style name="Widget.HtmlNotes.Tool" parent="" />
    <style name="Widget.HtmlNotes.Settings" parent="" />
    <style name="Widget.HtmlNotes.Sheet" parent="" />

    <!-- ════════ 顶栏标题（自绘顶栏与首页 MaterialToolbar 共用同一套字阶） ════════ -->

    <style name="Widget.HtmlNotes.TopBarTitle" parent="TextAppearance.HtmlNotes.ToolbarTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- ════════ 编辑器：顶栏图标按钮 ════════ -->
    <style name="Widget.HtmlNotes.TopIconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ════════ 编辑器：底部工具栏按钮 ════════ -->

    <!-- 一级工具栏文字按钮（B/I/U/S/Aa）：40dp 方块，选中态由 bg_tool_btn 描色 -->
    <style name="Widget.HtmlNotes.Tool.Square">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_tool_btn</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/tool_btn_text</item>
    </style>

    <!-- 一级工具栏图标按钮：40dp，图标色随选中态切换 -->
    <style name="Widget.HtmlNotes.Tool.Icon40" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_tool_btn</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
        <item name="android:tint">@color/tool_btn_tint</item>
    </style>

    <!-- 面板内图标按钮：36dp 紧凑态 -->
    <style name="Widget.HtmlNotes.Tool.Icon36" parent="Widget.HtmlNotes.Tool.Icon40">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">6dp</item>
    </style>

    <!-- 面板内文字胶囊（标题层级 / Aa / A / 字体名） -->
    <style name="Widget.HtmlNotes.Tool.Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/bg_tool_btn</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textColor">@color/tool_btn_text</item>
    </style>

    <!-- 代码片段胶囊：稍宽 + 统一 14sp -->
    <style name="Widget.HtmlNotes.Tool.Chip.Wide" parent="Widget.HtmlNotes.Tool.Chip">
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!--
      选区浮条的动作项。比普通 Chip 高一档（40dp）：浮条是手指最容易
      够偏的地方，且它要能一眼读出 B/I/U 的当前状态。文字统一 14sp。
    -->
    <style name="Widget.HtmlNotes.Selection.Action" parent="Widget.HtmlNotes.Tool.Chip">
        <item name="android:layout_height">40dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
    </style>

    <!--
      一级工具栏的面板入口：图标 + 文字标签，40dp 高度与 B/I/U/S 对齐。
      原来只放一个抽象图标和「Aa」，不点开看不出里面是哪些功能，所以总是找不到。
      文字色不能靠 Chip 的 textColor（ViewGroup 上无效），由内部 TextView 各自指定。
    -->
    <style name="Widget.HtmlNotes.Tool.LabelChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_tool_btn</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- 键盘收起时的工具栏胶囊入口（自带背景与阴影：父容器不再挂背景，
             否则展开瞬间会有一条满屏磨砂条直接出现，与高度动画打架） -->
    <style name="Widget.HtmlNotes.Tool.Capsule">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:background">@drawable/bg_toolbar_dock</item>
        <item name="android:elevation">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">20dp</item>
    </style>

    <!-- ════════ 设置页 ════════ -->

    <!-- 分区圆角卡片：20dp M3 Expressive 饱满圆角 + 1dp hairline 描边 -->
    <style name="Widget.HtmlNotes.Settings.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>

    <!-- 分区标题：左缩进 = 卡片外边距 16dp + 行内边距 16dp，与卡片内容区左边缘对齐 -->
    <style name="Widget.HtmlNotes.Settings.SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <!-- 编辑风的分组标签：疏排小字，与正文字距拉开层级 -->
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- 信息行基类：不可点击（作者/版本等纯展示行） -->
    <style name="Widget.HtmlNotes.Settings.RowBase">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- 设置行：图标 + 标题（+ 可选值），整行可点 -->
    <style name="Widget.HtmlNotes.Settings.Row" parent="Widget.HtmlNotes.Settings.RowBase">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.HtmlNotes.Settings.Icon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.HtmlNotes.Settings.Title">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">middle</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.HtmlNotes.Settings.Value">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">middle</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.HtmlNotes.Settings.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <!-- ════════ "更多"底部弹层 ════════ -->
    <style name="Widget.HtmlNotes.Sheet.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">14dp</item>
    </style>

    <style name="Widget.HtmlNotes.Sheet.Icon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.HtmlNotes.Sheet.Title">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">18dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- ════════ Material 3 Expressive 造型系统 ════════ -->

    <!-- M3 Expressive 核心动作 Hero FAB：20dp 饱满圆角方 (CornerLargeIncreased) -->
    <style name="ShapeAppearance.M3Expressive.FAB" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSize">20dp</item>
    </style>

    <!-- M3 Expressive 内容容器卡片：20dp 圆角 (CornerLargeIncreased) -->
    <style name="ShapeAppearance.M3Expressive.Card" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSize">20dp</item>
    </style>

    <!-- M3 Expressive 底部抽屉：28dp 顶圆角 (CornerExtraLargeTop) -->
    <style name="ShapeAppearance.M3Expressive.BottomSheet" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
