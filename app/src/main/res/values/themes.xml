<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HtmlNotes" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorError">@color/md_error</item>
        <item name="android:windowBackground">@color/md_surface</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- M3 其余色阶：补齐才能让 Material 组件（卡片/弹层/chip 等）拿到成套的官方色值 -->
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>

        <!-- 输入框选区手柄 / 光标跟随主题色（换肤后同样生效） -->
        <item name="colorControlActivated">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.HtmlNotes.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <!-- 编辑风：标题走衬线，正文仍无衬线；缺衬线字形按系统 serif 回退 -->
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- 主题色覆盖层（运行时按需 applyStyle）：primary + secondary 两套容器色，
         保证 chip / badge / 悬浮条等使用 secondaryContainer 的组件也跟随换肤 -->
    <style name="ThemePromptNoteIndigo">
        <item name="colorPrimary">@color/theme_indigo_primary</item>
        <item name="colorOnPrimary">@color/theme_indigo_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_indigo_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_indigo_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/theme_indigo_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/theme_indigo_on_secondary_container</item>
    </style>

    <style name="ThemePromptNoteTeal">
        <item name="colorPrimary">@color/theme_teal_primary</item>
        <item name="colorOnPrimary">@color/theme_teal_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_teal_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_teal_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/theme_teal_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/theme_teal_on_secondary_container</item>
    </style>

    <style name="ThemePromptNoteCoral">
        <item name="colorPrimary">@color/theme_coral_primary</item>
        <item name="colorOnPrimary">@color/theme_coral_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_coral_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_coral_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/theme_coral_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/theme_coral_on_secondary_container</item>
    </style>

    <style name="ThemePromptNoteOrange">
        <item name="colorPrimary">@color/theme_orange_primary</item>
        <item name="colorOnPrimary">@color/theme_orange_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_orange_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_orange_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/theme_orange_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/theme_orange_on_secondary_container</item>
    </style>

    <style name="ThemePromptNoteRose">
        <item name="colorPrimary">@color/theme_rose_primary</item>
        <item name="colorOnPrimary">@color/theme_rose_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_rose_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_rose_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/theme_rose_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/theme_rose_on_secondary_container</item>
    </style>

    <style name="ThemePromptNoteViolet">
        <item name="colorPrimary">@color/theme_violet_primary</item>
        <item name="colorOnPrimary">@color/theme_violet_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_violet_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_violet_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/theme_violet_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/theme_violet_on_secondary_container</item>
    </style>

    <style name="ThemePromptNoteSky">
        <item name="colorPrimary">@color/theme_sky_primary</item>
        <item name="colorOnPrimary">@color/theme_sky_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_sky_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_sky_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/theme_sky_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/theme_sky_on_secondary_container</item>
    </style>

    <style name="ThemePromptNoteForest">
        <item name="colorPrimary">@color/theme_forest_primary</item>
        <item name="colorOnPrimary">@color/theme_forest_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_forest_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_forest_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/theme_forest_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/theme_forest_on_secondary_container</item>
    </style>
</resources>
